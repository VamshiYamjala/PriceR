PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/priceradar
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Retailer credentials (leave blank until approval arrives — see Guide 1 & 4)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Notification service credentials (configure per Guide 4)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=PriceRadar
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PriceRadar_Alerts_Bot

# Monitoring trigger secret & switch
MONITOR_TRIGGER_SECRET=replace-with-a-long-random-string
MONITORING_ENABLED=true

# Optional Genuine Marketplace: eBay Browse API (leave blank for ₹0 budget / demo mode)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Apify Data Platform (Primary External Data Collection)
APIFY_API_TOKEN=
APIFY_ACTOR_AMAZON=junglee/free-amazon-product-scraper
APIFY_ACTOR_FLIPKART=shahidirfan/Flipkart-Product-Scraper
APIFY_ACTOR_MEESHO=scrapeai/meesho-product-scraper
APIFY_MAX_ITEMS=5
APIFY_TIMEOUT_SECS=60
